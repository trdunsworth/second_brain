    "# Formal test of difference between correlations\n",
    "def compare_correlations(r1, n1, r2, n2):\n",
    "\"\"\"Test if two correlations differ significantly (Fisher r-to-z).\"\"\"\n",
    "    z1 = np.arctanh(r1)\n",
    "    z2 = np.arctanh(r2)\n",
    "    se = np.sqrt(1/(n1-3) + 1/(n2-3))\n",
    "    z = (z1 - z2) / se\n",
    "    p = 2 * (1 - stats.norm.cdf(abs(z)))\n",
    "    return z, p\n",
    "\n",
    "# Example comparison (using actual values from above)\n",
    "law_data = incidents[incidents[\"agency\"]==\"LAW\"][\"dispatch_queue_seconds\"].dropna()\n",
    "fire_data = incidents[incidents[\"agency\"]==\"FIRE\"][\"dispatch_queue_seconds\"].dropna()\n",
    "ems_data = incidents[incidents[\"agency\"]==\"EMS\"][\"dispatch_queue_seconds\"].dropna()\n",
    "\n",
    "# Correlate with travel time\n",
    "for agency in [\"LAW\", \"FIRE\", \"EMS\"]:\n",
    "    subset = incidents[incidents[\"agency\"]==agency][[\"dispatch_queue_seconds\", \"travel_seconds\"]].dropna()\n",
    "    r, p = spearmanr(subset[\"dispatch_queue_seconds\"], subset[\"travel_seconds\"])\n",
    "    print(f\"{agency}: ρ={r:.3f}, n={len(subset)}\")"
