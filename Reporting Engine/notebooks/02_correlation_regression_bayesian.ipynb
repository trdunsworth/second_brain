    "## 6. Correlation by Groups (Moderation Analysis)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def correlation_by_group(df, x_col, y_col, group_col, method=\"spearman\"):\n",
    "\"\"\"Compute correlation within each group.\"\"\"\n",
    "    groups = df[group_col].unique()\n",
    "    results = []\n",
    "    \n",
    "    for g in groups:\n",
    "        subset = df[df[group_col] == g][[x_col, y_col]].dropna()\n",
    "        if len(subset) >= 10:\n",
    "            if method == \"spearman\":\n",
    "                r, p = spearmanr(subset[x_col], subset[y_col])\n",
    "            elif method == \"pearson\":\n",
    "                r, p = pearsonr(subset[x_col], subset[y_col])\n",
    "            elif method == \"kendall\":\n",
    "                r, p = kendalltau(subset[x_col], subset[y_col])\n",
    "            \n",
    "            # CI via Fisher transform\n",
    "            z = np.arctanh(r)\n",
    "            se = 1 / np.sqrt(len(subset) - 3)\n",
    "            ci_low = np.tanh(z - 1.96 * se)\n",
    "            ci_high = np.tanh(z + 1.96 * se)\n",
    "            \n",
    "            results.append({\n",
    "                \"group\": g,\n",
    "                \"n\": len(subset),\n",
    "                \"r\": r,\n",
    "                \"p\": p,\n",
    "                \"ci_low\": ci_low,\n",
    "                \"ci_high\": ci_high\n",
    "            })\n",
    "    \n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "# Dispatch queue vs Travel by Agency\n",
    "for agency in incidents[\"agency\"].unique():\n",
    "    subset = incidents[incidents[\"agency\"] == agency][[\"dispatch_queue_seconds\", \"travel_seconds\"]].dropna()\n",
    "    if len(subset) > 10:\n",
    "        r, p = spearmanr(subset[\"dispatch_queue_seconds\"], subset[\"travel_seconds\"])\n",
    "        print(f\"{agency}: ρ={r:.3f}, p={p:.4f}, n={len(subset)}\")"
   ]
