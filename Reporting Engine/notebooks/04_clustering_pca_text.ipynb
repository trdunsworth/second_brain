    "plt.axhline(0.8, color='r', linestyle='--', label='80%')\n",
    "plt.axhline(0.9, color='g', linestyle='--', label='90%')\n",
    "plt.xlabel(\"Component\")\n",
    "plt.ylabel(\"Cumulative Variance\")\n",
    "plt.title(\"Cumulative Variance\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Biplot\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "X_pca = pca_results[\"X_pca\"]\n",
    "loadings = pca_results[\"loadings\"]\n",
    \n",
    "valid_idx = incidents[features].notna().all(axis=1)\n",
    "scatter = ax.scatter(X_pca[:, 0], X_pca[:, 1], \n",
    "               alpha=0.3, s=5, \n",
    "               c=incidents.loc[valid_idx, \"priority\"].values, cmap='viridis')\n",
    "\n",
    "for j, feat in enumerate(features):\n",
    "    ax.arrow(0, 0, loadings.iloc[j, 0]*3, loadings.iloc[j, 1]*3, \n",
    "             head_width=0.1, head_length=0.1, fc='red', ec='red')\n",
    "    ax.text(loadings.iloc[j, 0]*3.2, loadings.iloc[j, 1]*3.2, feat, \n",
    "            fontsize=9, color='red')\n",
    "\n",
    "ax.axhline(0, color='gray', linestyle='--', alpha=0.5)\n",
    "ax.axvline(0, color='gray', linestyle='--', alpha=0.5)\n",
    "ax.set_xlabel(f\"PC1 ({pca_results['var_exp'][0]*100:.1f}%)\")\n",
    "ax.set_ylabel(f\"PC2 ({pca_results['var_exp'][1]*100:.1f}%)\")\n",
    "ax.set_title(\"PCA Biplot (Time Components)\")\n",
    "plt.colorbar(scatter, label=\"Priority\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
