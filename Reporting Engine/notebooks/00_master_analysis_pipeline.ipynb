   "source": [
    "## ANALYSIS TYPE 3: CORRELATION ANALYSIS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation matrices\n",
    "def corr_matrix(df, cols):\n",
    "    r = df[cols].corr(method=\"spearman\")\n",
    "    p = pd.DataFrame(index=cols, columns=cols, dtype=float)\n",
    "    for i in cols:\n",
    "        for j in cols:\n",
    "            if i != j: p.loc[i, j] = spearmanr(df[i].dropna(), df[j].dropna())[1]\n",
    "    return r, p\n",
    "\n",
    "r_spearman, p_spearman = corr_matrix(incidents, time_cols)\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "mask = p_spearman > 0.05\n",
    "sns.heatmap(r_spearman, annot=True, fmt=\".2f\", cmap=\"RdBu_r\", center=0, \n",
    "            mask=mask, square=True, cbar_kws={\"shrink\": 0.8})\n",
    "plt.title(\"Spearman Correlation (p>0.05 masked)\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Categorical associations (Cramér's V)\n",
    "cat_cols = [\"agency\", \"shift_label\", \"priority\", \"problem_nature\", \"call_disposition\"]\n",
    "cv = pd.DataFrame(index=cat_cols, columns=cat_cols, dtype=float)\n",
    "for i in cat_cols:\n",
    "    for j in cat_cols:\n",
    "        if i != j:\n",
    "            ct = pd.crosstab(incidents[i], incidents[j])\n",
    "            chi2 = chi2_contingency(ct)[0]\n",
    "            n = ct.sum().sum()\n",
    "            min_dim = min(ct.shape) - 1\n",
    "            if min_dim > 0: cv.loc[i, j] = np.sqrt(chi2 / (n * min_dim))\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(cv.astype(float), annot=True, fmt=\".2f\", cmap=\"viridis\", center=0, square=True)\n",
    "plt.title(\"Cramér's V: Categorical Associations\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## ANALYSIS TYPE 4: REGRESSION ANALYSIS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# GLM Suite\n",
    "from statsmodels.genmod.families import Gamma, NegativeBinomial, InverseGaussian, Tweedie\n",
    "from statsmodels.genmod.families.links import Log, Identity\n",
    "\n",
    "predictors = \"C(priority) + C(agency) + C(shift_label) + C(problem_nature) + hour + is_weekend\"\n",
    "\n",
    "for name, fam in {\n",
    "    \"Gamma-Log\": Gamma(link=Log()),\n",
    "    \"InvGauss-Log\": InverseGaussian(link=Log()),\n",
    "    \"NegBin-Log\": NegativeBinomial(link=Log()),\n",
    "}.items():\n",
    "    try:\n",
    "        m = smf.glm(f\"total_elapsed_seconds ~ {predictors}\", data=incidents, family=fam).fit()\n",
    "        print(f\"{name}: AIC={m.aic:.1f}, BIC={m.bic:.1f}\")\n",
    "    except: pass\n",
    "\n",
    "# Best model\n",
    "best = smf.glm(f\"total_elapsed_seconds ~ {predictors}\", data=incidents, family=Gamma(link=Log())).fit()\n",
    "print(best.summary().tables[1].head(15))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Quantile Regression\n",
    "for q in [0.1, 0.5, 0.9, 0.95, 0.99]:\n",
    "    m = smf.quantreg(f\"dispatch_queue_seconds ~ C(priority) + C(agency) + C(shift_label) + hour\", \n",
    "                     incidents).fit(q=q)\n",
    "    print(f\"Q{q}: pseudo R²={m.prsquared:.3f}\")\n",
    "    print(m.params.filter(like=\"priority\").round(3))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Bayesian GLM with Bambi\n",
    "model_bayes, trace_bayes = bmb.Model(\n",
    "    \"total_elapsed_seconds ~ C(priority) + C(agency) + C(shift_label) + hour + is_weekend\",\n",
    "    incidents, family=\"gamma\", link=\"log\"\n",
    ").fit(draws=2000, tune=1000, chains=4, target_accept=0.95, random_seed=42)\n",
    "\n",
    "print(az.summary(trace_bayes, var_names=[\"~Intercept\", \"C(priority)\", \"C(agency)\"], hdi_prob=0.95))"
   ]
