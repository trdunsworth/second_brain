    "# Difference-in-Differences (Simulated)\n",
    "incidents[\"post\"] = (incidents[\"dow\"] >= 3).astype(int)\n",
    "incidents[\"treated\"] = (incidents[\"agency\"] == \"LAW\").astype(int)\n",
    "incidents[\"did\"] = incidents[\"post\"] * incidents[\"treated\"]\n",
    "\n",
    "did = smf.ols(\"log_queue ~ post + treated + did + C(priority) + hour\", data=incidents).fit()\n",
    "print(f\"DiD estimate: {did.params['did']:.4f}, p={did.pvalues['did']:.4f}\")\n",
    "print(f\"95% CI: {did.conf_int().loc['did'].round(4).tolist()}\")\n",
    "\n",
    "# Interrupted Time Series\n",
    "daily = incidents.set_index(\"call_start_time\").resample(\"D\")[\"dispatch_queue_seconds\"].median().reset_index()\n",
    "daily[\"time\"] = range(len(daily))\n",
    "daily[\"post\"] = (daily[\"time\"] >= 3).astype(int)\n",
    "daily[\"time_post\"] = daily[\"time\"] * daily[\"post\"]\n",
    "\n",
    "its = smf.ols(\"dispatch_queue_seconds ~ time + post + time_post\", data=daily).fit()\n",
    "print(f\"ITS Level change: {its.params['post']:.2f}, p={its.pvalues['post']:.4f}\")\n",
    "print(f\"ITS Slope change: {its.params['time_post']:.4f}, p={its.pvalues['time_post']:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
