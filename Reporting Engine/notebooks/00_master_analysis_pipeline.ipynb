  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Forecasting\n",
    "train = ts_911[:120]  # 5 days\n",
    "test = ts_911[120:168]  # 2 days\n",
    "\n",
    "models = {}\n",
    "forecasts = {}\n",
    "\n",
    "# Naive\n",
    "forecasts[\"Naive\"] = np.full(48, train.iloc[-1])\n",
    "# Seasonal Naive\n",
    "forecasts[\"Seasonal_Naive\"] = train.iloc[-168:].values[-48:]\n",
    "# Holt-Winters\n",
    "hw = ExponentialSmoothing(train, trend=\"add\", seasonal=\"add\", seasonal_periods=24).fit()\n",
    "forecasts[\"Holt_Winters\"] = hw.forecast(48)\n",
    "# ARIMA\n",
    "arima = ARIMA(train, order=(1,1,1)).fit()\n",
    "forecasts[\"ARIMA\"] = arima.forecast(48)\n",
    "\n",
    "for name, fc in forecasts.items():\n",
    "    mae = np.mean(np.abs(fc[:len(test)] - test.values))\n",
    "    rmse = np.sqrt(np.mean((fc[:len(test)] - test.values)**2))\n",
    "    print(f\"{name}: MAE={mae:.2f}, RMSE={rmse:.2f}\")\n",
    "\n",
    "plt.figure(figsize=(14, 5))\n",
    "plt.plot(test.index, test.values, 'k-', label='Actual', lw=2)\n",
    "for name, fc in forecasts.items():\n",
    "    plt.plot(test.index, fc[:len(test)], '--', label=name, alpha=0.7)\n",
    "plt.legend(); plt.title(\"911 Forecasts (Last 2 Days)\"); plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Bayesian Structural Time Series\n",
    "y = ts_911[-72:].values  # Last 3 days\n",
    "y_std = (y - y.mean()) / y.std()\n",
    "n = len(y_std)\n",
    "\n",
    "with pm.Model() as m:\n",
    "    sigma_obs = pm.HalfNormal(\"sigma_obs\", 0.1)\n",
    "    sigma_level = pm.HalfNormal(\"sigma_level\", 0.01)\n",
    "    level = pm.GaussianRandomWalk(\"level\", sigma=sigma_level, init_dist=pm.Normal.dist(0,1), shape=n)\n",
    "    sigma_slope = pm.HalfNormal(\"sigma_slope\", 0.001)\n",
    "    slope = pm.GaussianRandomWalk(\"slope\", sigma=sigma_slope, init_dist=pm.Normal.dist(0,0.1), shape=n)\n",
    "    trend = pm.Deterministic(\"trend\", level + pm.math.cumsum(slope))\n",
    "    \n",
    "    seasonal = 0\n",
    "    for k in range(1, 7):\n",
    "        a = pm.Normal(f\"a_{k}\", 0, 0.1)\n",
    "        b = pm.Normal(f\"b_{k}\", 0, 0.1)\n",
    "        t = np.arange(n)\n",
    "        seasonal += a * np.sin(2*np.pi*k*t/24) + b * np.cos(2*np.pi*k*t/24)\n",
    "    seasonal = pm.Deterministic(\"seasonal\", seasonal)\n",
    "    \n",
    "    mu = pm.Deterministic(\"mu\", trend + seasonal)\n",
    "    pm.Normal(\"y\", mu=mu, sigma=sigma_obs, observed=y_std)\n",
    "    trace = pm.sample(2000, tune=1500, chains=4, target_accept=0.95, random_seed=42)\n",
    "\n",
    "# Forecast\n",
    "with m:\n",
    "    post_level = trace.posterior[\"level\"][:,:,-1].values\n",
    "    post_slope = trace.posterior[\"slope\"][:,:,-1].values\n",
    "    post_trend = trace.posterior[\"trend\"][:,:,-1].values\n",
    "    \n",
    "    t_future = np.arange(n, n+24)\n",
    "    seasonal_future = 0\n",
    "    for k in range(1, 7):\n",
    "        a = trace.posterior[f\"a_{k}\"].mean().values\n",
    "        b = trace.posterior[f\"b_{k}\"].mean().values\n",
    "        seasonal_future += a * np.sin(2*np.pi*k*t_future/24) + b * np.cos(2*np.pi*k*t_future/24)\n",
    "    \n",
    "    trend_future = post_trend[:,None] + np.cumsum(post_slope[:,None] * np.ones(24), axis=1)\n",
    "    mu_future = trend_future + seasonal_future\n",
    "    sigma_obs_p = trace.posterior[\"sigma_obs\"].mean().values\n",
    "    fc_samples = np.random.normal(mu_future, sigma_obs_p)\n",
    "    \n",
    "    fc_mean = fc_samples.mean(axis=0) * y.std() + y.mean()\n",
    "    fc_lo = np.percentile(fc_samples, 2.5, axis=0) * y.std() + y.mean()\n",
    "    fc_hi = np.percentile(fc_samples, 97.5, axis=0) * y.std() + y.mean()\n",
    "\n",
    "plt.figure(figsize=(12, 5))\n",
    "hist_idx = ts_911[-72:].index\n",
    "fut_idx = pd.date_range(hist_idx[-1] + pd.Timedelta(hours=1), periods=24, freq=\"h\")\n",
    "plt.plot(hist_idx, ts_911[-72:].values, 'k-', alpha=0.5)\n",
    "plt.plot(fut_idx, fc_mean, 'b-')\n",
    "plt.fill_between(fut_idx, fc_lo, fc_hi, alpha=0.2, color='blue')\n",
    "plt.title(\"BSTS Forecast (911 Calls)\")\n",
    "plt.show()"
   ]
  },
