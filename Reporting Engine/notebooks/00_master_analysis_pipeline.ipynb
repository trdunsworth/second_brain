   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## ANALYSIS TYPE 1: DESCRIPTIVE ANALYSIS\n",
    "### Executive KPI Scorecard"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Executive KPI Scorecard with Standards\n",
    "def executive_kpi_scorecard(incidents, calls):\n",
    "    total_911 = calls[\"nine_one_one_calls_received\"].sum()\n",
    "    total_non_emerg = calls[\"non_emergency_calls_received\"].sum()\n",
    "    total_incidents = len(incidents)\n",
    "    \n",
    "    answered_15s = int((calls[\"nine_one_one_answered_15s_pct\"]/100 * calls[\"nine_one_one_calls_received\"]).sum())\n",
    "    answered_20s = int((calls[\"nine_one_one_answered_20s_pct\"]/100 * calls[\"nine_one_one_calls_received\"]).sum())\n",
    "    \n",
    "    pct_15s = answered_15s / total_911 * 100\n",
    "    pct_20s = answered_20s / total_911 * 100\n",
    "    \n",
    "    nfpa = {}\n",
    "    dq_p90 = np.percentile(incidents[\"dispatch_queue_seconds\"].dropna(), 90)\n",
    "    dq_p95 = np.percentile(incidents[\"dispatch_queue_seconds\"].dropna(), 95)\n",
    "    nfpa[\"Dispatch Queue\"] = {\"p90\": dq_p90, \"p95\": dq_p95, \"t90\": 64, \"t95\": 106}\n",
    "    \n",
    "    for agency, target in [(\"EMS\", 60), (\"FIRE\", 80)]:\n",
    "        agency_data = incidents[incidents[\"agency\"]==agency][\"turnout_seconds\"].dropna()\n",
    "        if len(agency_data) > 0:\n",
    "            nfpa[f\"Turnout ({agency})\"] = {\"p90\": np.percentile(agency_data, 90), \"t90\": target}\n",
    "    \n",
    "    travel_p90 = np.percentile(incidents[\"travel_seconds\"].dropna(), 90)\n",
    "    nfpa[\"Travel Time\"] = {\"p90\": travel_p90, \"t90\": 240}\n",
    "    \n",
    "    scorecard = {\n",
    "        \"Total 9-1-1 Calls\": total_911,\n",
    "        \"Total Non-Emergency\": total_non_emerg,\n",
    "        \"Total Incidents\": total_incidents,\n",
    "        \"NENA 15s Compliance\": f\"{pct_15s:.1f}% (Target: 90%)\",\n",
    "        \"NENA 20s Compliance\": f\"{pct_20s:.1f}% (Target: 95%)\",\n",
    "    }\n",
    "    \n",
    "    for metric, vals in nfpa.items():\n",
    "        if \"p95\" in vals:\n",
    "            status = \"✅\" if vals[\"p90\"] <= vals[\"t90\"] and vals[\"p95\"] <= vals[\"t95\"] else \"❌\"\n",
    "            scorecard[f\"NFPA {metric}\"] = f\"P90={vals['p90']:.0f}s (≤{vals['t90']}s), P95={vals['p95']:.0f}s (≤{vals['t95']}s) {status}\"\n",
    "        else:\n",
    "            status = \"✅\" if vals[\"p90\"] <= vals[\"t90\"] else \"❌\"\n",
    "            scorecard[f\"NFPA {metric}\"] = f\"P90={vals['p90']:.0f}s (≤{vals['t90']}s) {status}\"\n",
    "    \n",
    "    return pd.DataFrame(list(scorecard.items()), columns=[\"Metric\", \"Value\"])\n",
    "\n",
    "scorecard = executive_kpi_scorecard(incidents, calls)\n",
    "print(\"EXECUTIVE KPI SCORECARD\")\n",
    "print(\"=\" * 60)\n",
    "print(scorecard.to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Operational Process Capability"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Process Capability\n",
    "def process_capability(data, spec_lsl=None, spec_usl=None, target=None):\n",
    "    data = data.dropna()\n",
    "    mean = data.mean()\n",
    "    std = data.std(ddof=1)\n",
    "    res = {\"mean\": mean, \"std\": std, \"n\": len(data)}\n",
    "    if spec_usl and spec_lsl:\n",
    "        cp = (spec_usl - spec_lsl) / (6 * std)\n",
    "        cpu = (spec_usl - mean) / (3 * std)\n",
    "        cpl = (mean - spec_lsl) / (3 * std)\n",
    "        res[\"Cp\"] = cp; res[\"Cpk\"] = min(cpu, cpl); res[\"Cpu\"] = cpu; res[\"Cpl\"] = cpl\n",
    "    if target:\n",
    "        tau = np.sqrt(std**2 + (mean - target)**2)\n",
    "        res[\"Cpm\"] = (spec_usl - spec_lsl) / (6 * tau) if spec_usl and spec_lsl else np.nan\n",
    "    if \"Cpk\" in res:\n",
    "        res[\"Interpretation\"] = \"Excellent\" if res[\"Cpk\"] >= 1.67 else \"Good\" if res[\"Cpk\"] >= 1.33 else \"Adequate\" if res[\"Cpk\"] >= 1.0 else \"Inadequate\"\n",
    "    return res\n",
    "\n",
    "print(\"PROCESS CAPABILITY\")\n",
    "print(\"=\" * 60)\n",
    "for name, data, usl, target in [\n",
    "    (\"Dispatch Queue\", incidents[\"dispatch_queue_seconds\"], 106, 64),\n",
    "    (\"EMS Turnout\", incidents[incidents[\"agency\"]==\"EMS\"][\"turnout_seconds\"], 60, 45),\n",
    "    (\"Fire Turnout\", incidents[incidents[\"agency\"]==\"FIRE\"][\"turnout_seconds\"], 80, 60),\n",
    "]:\n",
    "    cap = process_capability(data, spec_lsl=0, spec_usl=usl, target=target)\n",
    "    print(f\"\\n{name}:\")\n",
    "    for k, v in cap.items():\n",
    "        print(f\"  {k}: {v}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Shift Supervisor Personnel Scorecards"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Personnel Scorecards\n",
    "def personnel_scorecard(incidents, min_calls=10):\n",
    "    ct = incidents.groupby(\"calltaker\").agg(\n",
    "        n=(\"id_number\", \"count\"),\n",
    "        median_pickup=(\"pickup_delay_seconds\", \"median\"),\n",
    "        median_interview=(\"interview_seconds\", \"median\"),\n",
    "        pct_undef=(\"call_disposition\", lambda x: (x==\"UNDEFINED\").mean()*100),\n",
    "        median_total=(\"total_elapsed_seconds\", \"median\"),\n",
    "    ).query(\"n >= @min_calls\").reset_index()\n",
    "    \n",
    "    for col in [\"median_pickup\", \"median_interview\", \"median_total\", \"pct_undef\"]:\n",
    "        q1, q3 = ct[col].quantile([0.25, 0.75])\n",
    "        iqr = q3 - q1\n",
    "        ct[f\"{col}_outlier\"] = (ct[col] < q1 - 1.5*iqr) | (ct[col] > q3 + 1.5*iqr)\n",
    "    ct[\"any_outlier\"] = ct.filter(like=\"_outlier\").any(axis=1)\n",
    "    \n",
    "    disp = incidents.groupby(\"dispatcher\").agg(\n",
    "        n=(\"id_number\", \"count\"),\n",
    "        median_queue=(\"dispatch_queue_seconds\", \"median\"),\n",
    "        median_turnout=(\"turnout_seconds\", \"median\"),\n",
    "        median_travel=(\"travel_seconds\", \"median\"),\n",
    "    ).query(\"n >= @min_calls\").reset_index()\n",
    "    \n",
    "    for col in [\"median_queue\", \"median_turnout\", \"median_travel\"]:\n",
    "        q1, q3 = disp[col].quantile([0.25, 0.75])\n",
    "        iqr = q3 - q1\n",
    "        disp[f\"{col}_outlier\"] = (disp[col] < q1 - 1.5*iqr) | (disp[col] > q3 + 1.5*iqr)\n",
    "    disp[\"any_outlier\"] = disp.filter(like=\"_outlier\").any(axis=1)\n",
    "    \n",
    "    return ct, disp\n",
    "\n",
    "ct, disp = personnel_scorecard(incidents)\n",
    "print(\"CALLTAKER OUTLIERS:\")\n",
    "print(ct[ct[\"any_outlier\"]][[\"calltaker\", \"n\", \"median_pickup\", \"median_interview\", \"median_total\", \"pct_undef\"]].to_string(index=False))\n",
    "print(\"\\nDISPATCHER OUTLIERS:\")\n",
    "print(disp[disp[\"any_outlier\"]][[\"dispatcher\", \"n\", \"median_queue\", \"median_turnout\", \"median_travel\"]].to_string(index=False))"
   ]
  },
