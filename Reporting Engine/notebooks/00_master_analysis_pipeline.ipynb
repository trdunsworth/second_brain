  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## ANALYSIS TYPE 5: HYPOTHESIS TESTING"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compliance Hypothesis Tests\n",
    "total_911 = calls[\"nine_one_one_calls_received\"].sum()\n",
    "ans_15 = int((calls[\"nine_one_one_answered_15s_pct\"]/100 * calls[\"nine_one_one_calls_received\"]).sum())\n",
    "ans_20 = int((calls[\"nine_one_one_answered_20s_pct\"]/100 * calls[\"nine_one_one_calls_received\"]).sum())\n",
    "ans_10 = int((calls[\"nine_one_one_answered_10s_pct\"]/100 * calls[\"nine_one_one_calls_received\"]).sum())\n",
    "\n",
    "tests = {\n",
    "    \"NENA 15s\": binomtest(ans_15, total_911, p=0.90, alternative=\"greater\"),\n",
    "    \"NENA 20s\": binomtest(ans_20, total_911, p=0.95, alternative=\"greater\"),\n",
    "    \"APCO 10s\": binomtest(ans_10, total_911, p=0.75, alternative=\"greater\"),\n",
    "}\n",
    "\n",
    "print(\"COMPLIANCE TESTS:\")\n",
    "for name, t in tests.items():\n",
    "    ci = proportion_confint(getattr(t, 'k', ans_15), total_911, method=\"wilson\")\n",
    "    print(f\"{name}: p={t.pvalue:.6f}, CI=[{ci[0]:.3f}, {ci[1]:.3f}] → {'PASS' if t.pvalue<0.05 else 'FAIL'}\")\n",
    "\n",
    "# NFPA Dispatch Queue\n",
    "dq = incidents[\"dispatch_queue_seconds\"].dropna()\n",
    "for target, pct in [(64, 0.90), (106, 0.95)]:\n",
    "    p = (dq <= target).mean()\n",
    "    t = binomtest(int(p*len(dq)), len(dq), p=pct, alternative=\"greater\")\n",
    "    ci = proportion_confint(int(p*len(dq)), len(dq), method=\"wilson\")\n",
    "    print(f\"NFPA DQ ≤{target}s: p={t.pvalue:.6f}, CI=[{ci[0]:.3f}, {ci[1]:.3f}] → {'PASS' if t.pvalue<0.05 else 'FAIL'}\")\n",
    "\n",
    "# Group comparison: shifts\n",
    "shift_groups = [g[\"total_elapsed_seconds\"].dropna() for _, g in incidents.groupby(\"shift_label\")]\n",
    "h, p = kruskal(*shift_groups)\n",
    "print(f\"\\nKruskal-Wallis (shifts): H={h:.2f}, p={p:.6f}\")\n",
    "dunn = sp.posthoc_dunn(incidents, val_col=\"total_elapsed_seconds\", group_col=\"shift_label\", p_adjust=\"bonferroni\")\n",
    "print(dunn.round(4))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Bayesian Compliance (ROPE)\n",
    "with pm.Model() as m:\n",
    "    p = pm.Beta(\"p\", alpha=90, beta=10)\n",
    "    pm.Binomial(\"obs\", n=total_911, p=p, observed=ans_15)\n",
    "    trace = pm.sample(3000, tune=1500, chains=4, target_accept=0.95, random_seed=42)\n",
    "\n",
    "post = trace.posterior[\"p\"].values.flatten()\n",
    "prob = (post > 0.90).mean()\n",
    "rope = ((post >= 0.88) & (post <= 0.92)).mean()\n",
    "below = (post < 0.88).mean()\n",
    "above = (post > 0.92).mean()\n",
    "\n",
    "print(f\"Bayesian NENA 15s:\")\n",
    print(f\"  Mean: {post.mean():.3f}, 95% HDI: {az.hdi(post, 0.95)}\")\n",
    print(f\"  P(>90%): {prob:.3f}, ROPE [88%,92%]: {rope:.3f}\")\n",
    print(f\"  Below ROPE: {below:.3f}, Above ROPE: {above:.3f}\")\n",
    print(f\"  Decision: {'Compliant' if prob>0.95 else 'Non-compliant' if below>0.95 else 'Uncertain'}\")"
   ]
  },
