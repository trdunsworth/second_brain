    "# Problem Nature Categorization\n",
    "def cat_problem(text):\n",
    "    t = str(text).lower()\n",
    "    med = [\"breathing\", \"cardiac\", \"chest\", \"pain\", \"fall\", \"injury\", \"sick\", \n",
    "           \"allergic\", \"seizure\", \"unconscious\", \"overdose\", \"pregnancy\", \n",
    "           \"childbirth\", \"mental\", \"heat\", \"cold\", \"abdominal\", \"traumatic\"]\n",
    "    fire = [\"fire\", \"gas\", \"odor\", \"smoke\", \"brush\", \"grass\", \"vehicle fire\",\n",
    "            \"structure\", \"elevator\", \"co\", \"overheat\", \"water\", \"rescue\", \"alarm\"]\n",
    "    law = [\"traffic\", \"stop\", \"reckless\", \"dui\", \"collision\", \"theft\", \n",
    "           \"burglary\", \"robbery\", \"assault\", \"harassment\", \"trespass\", \n",
    "           \"vandalism\", \"noise\", \"animal\", \"welfare\", \"suspicious\", \"shots\",\n",
    "           \"drug\", \"weapon\", \"missing\", \"disorderly\"]\n",
    "    if any(k in t for k in med): return \"Medical\"\n",
    "    if any(k in t for k in fire): return \"Fire\"\n",
    "    if any(k in t for k in law): return \"Law Enforcement\"\n",
    "    return \"Other\"\n",
    "\n",
    "incidents[\"problem_cat\"] = incidents[\"problem_nature\"].apply(cat_problem)\n",
    "print(incidents[\"problem_cat\"].value_counts(normalize=True).mul(100).round(1))\n",
    "\n",
    "cat_metrics = incidents.groupby(\"problem_cat\").agg(\n",
    "    n=(\"id_number\", \"count\"),\n",
    "    med_queue=(\"dispatch_queue_seconds\", \"median\"),\n",
    "    med_total=(\"total_elapsed_seconds\", \"median\"),\n",
    ").round(1)\n",
    "print(cat_metrics)"
   ]
