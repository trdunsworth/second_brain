   "source": [
    "# 9-1-1 Dispatch Data: Master Analysis Pipeline\n",
    "\n",
    "**Complete end-to-end analysis pipeline for all 12 analysis types**\n",
    "\n",
    "**Data**: `oz_test_incidents.csv` + `oz_test_hourly_call_counts.csv`\n",
    "**Standards**: NENA-STA-020.1, APCO ANS 3.101, NFPA 1710\n",
    "**Audiences**: Executive Staff, Operational Management, Shift Supervisors, Analysts/Researchers\n",
    "\n",
    "This notebook runs the complete pipeline and generates outputs for all four audiences."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# MASTER PIPELINE SETUP\n",
    "# ============================================================\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import plotnine as p9\n",
    "from scipy import stats\n",
    "from scipy.stats import spearmanr, kendalltau, pearsonr, mannwhitneyu, kruskal, chi2_contingency, binomtest\n",
    "import pingouin as pg\n",
    "import statsmodels.api as sm\n",
    "import statsmodels.formula.api as smf\n",
    "from statsmodels.tsa.stattools import adfuller, kpss\n",
    "from statsmodels.tsa.seasonal import STL\n",
    "from statsmodels.tsa.arima.model import ARIMA\n",
    "from statsmodels.tsa.holtwinters import ExponentialSmoothing\n",
    "from statsmodels.stats.proportion import proportion_confint\n",
    "from statsmodels.stats.multicomp import pairwise_tukeyhsd\n",
    "from statsmodels.regression.mixed_linear_model import MixedLM\n",
    "import scikit_posthocs as sp\n",
    "from sklearn.preprocessing import RobustScaler, StandardScaler\n",
    "from sklearn.cluster import KMeans, GaussianMixture, DBSCAN\n",
    "from sklearn.decomposition import PCA, SparsePCA\n",
    "from sklearn.metrics import silhouette_score\n",
    "from scipy.cluster.hierarchy import linkage, fcluster\n",
    "from collections import Counter\n",
    "import re\n",
    "\n",
    "# Bayesian\n",
    "import pymc as pm\n",
    "import arviz as az\n",
    "import bambi as bmb\n",
    "\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.width', 200)\n",
    "np.random.seed(42)\n",
    "az.style.use('arviz-darkgrid')\n",
    "\n",
    "print(\"Master Pipeline Libraries Loaded\")"
   ]
