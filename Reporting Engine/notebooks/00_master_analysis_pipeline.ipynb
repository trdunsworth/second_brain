   "source": [
    "### Analyst Distribution Diagnostics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Distribution Diagnostics Table\n",
    "def dist_diagnostics(df, cols):\n",
    "    res = []\n",
    "    for c in cols:\n",
    "        s = df[c].dropna()\n",
    "        row = {\"Variable\": c, \"N\": len(s), \"Missing_%\": df[c].isna().mean()*100,\n",
    "               \"Mean\": s.mean(), \"Median\": s.median(), \"Std\": s.std(),\n",
    "               \"CV\": s.std()/s.mean() if s.mean()!=0 else np.nan,\n",
    "               \"Skew\": stats.skew(s), \"Kurtosis\": stats.kurtosis(s),\n",
    "               \"IQR\": s.quantile(0.75)-s.quantile(0.25),\n",
    "               \"P01\": s.quantile(0.01), \"P05\": s.quantile(0.05),\n",
    "               \"P25\": s.quantile(0.25), \"P50\": s.quantile(0.50),\n",
    "               \"P75\": s.quantile(0.75), \"P95\": s.quantile(0.95), \"P99\": s.quantile(0.99)}\n",
    "        if len(s) <= 5000:\n",
    "            w, p = stats.shapiro(s); row[\"Shapiro_W\"]=w; row[\"Shapiro_p\"]=p\n",
    "        else:\n",
    "            ad = stats.anderson(s, dist='norm'); row[\"AD_stat\"]=ad.statistic; row[\"AD_5%\"]=ad.critical_values[2]\n",
    "        skew = row[\"Skew\"]\n",
    "        row[\"Family\"] = \"LogN/Gamma/Weibull\" if skew>2 else \"Gamma/LogN\" if skew>1 else \"Beta/ReflGamma\" if skew<-1 else \"Normal/t\"\n",
    "        res.append(row)\n",
    "    return pd.DataFrame(res)\n",
    "\n",
    "diag = dist_diagnostics(incidents, time_cols)\n",
    "print(\"DISTRIBUTION DIAGNOSTICS\")\n",
    "print(diag.round(3).to_string(index=False))"
   ]
  },
