   "source": [
    "# Incident Clustering\n",
    "X = incidents[time_cols].dropna()\n",
    "for c in time_cols:\n",
    "    if stats.skew(X[c]) > 1:\n",
    "        X[c] = np.log1p(X[c] - X[c].min() + 1)\n",
    "X_scaled = RobustScaler().fit_transform(X)\n",
    "\n",
    "best_sil = -1; best_k = 3\n",
    "for k in range(2, 7):\n",
    "    km = KMeans(n_clusters=k, random_state=42, n_init=20)\n",
    "    labels = km.fit_predict(X_scaled)\n",
    "    sil = silhouette_score(X_scaled, labels)\n",
    "    if sil > best_sil: best_sil, best_k = sil, k\n",
    "\n",
    "km = KMeans(n_clusters=best_k, random_state=42, n_init=20)\n",
    "incidents[\"cluster\"] = np.nan\n",
    "incidents.loc[X.index, \"cluster\"] = km.fit_predict(X_scaled)\n",
    "\n",
    "print(f\"Best K={best_k}, Silhouette={best_sil:.3f}\")\n",
    "print(incidents.groupby(\"cluster\")[time_cols].median().round(0))"
   ]
